# ==============================================================================
# InfraNexus AI Environment Configuration
# One Network. Zero Coordination Blind Spots.
# ==============================================================================

# Gemini AI API Key (Server-side proxy routes via @google/genai)
# Configure via AI Studio Secrets Panel or backend environment
GEMINI_API_KEY="your-gemini-api-key-here"

# Google Maps Platform JavaScript API Key (Browser Client)
# Enable 'Maps JavaScript API' in Google Cloud Console
# Restrict this key by HTTP referrers in Google Cloud Console Credentials
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-browser-api-key-here"

# Supabase Authentication & PostgreSQL persistence (Frontend-safe public keys only)
# Never place service-role secret keys here
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Application hosting URL (Injected automatically in Cloud Run / AI Studio)
APP_URL="https://your-deployment-domain.run.app"
